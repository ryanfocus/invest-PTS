# 複製此檔為 .env 後填入實際值。.env 已被 .gitignore 排除，不會進版控。
#
# ⚠️ 這裡面是可以直接下單的期貨帳密。不要貼給任何人、不要放進聊天視窗、
#    不要放在會被同步到雲端的資料夾。

# 群益登入帳號（身分證字號）
CAPITAL_USER_ID=

# 群益登入密碼
CAPITAL_PASSWORD=

# 期貨帳號：分公司代碼 + 帳號，例如 F999 + 0000000。
# 只有打開自動下單時才需要；模擬模式可以留空。
CAPITAL_FUTURES_ACCOUNT=

# Discord webhook。只有 config/settings.yaml 的 discord.enabled 為 true 時才需要。
DISCORD_WEBHOOK_URL=
